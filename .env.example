# Strava OAuth — get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_production_client_id
STRAVA_CLIENT_SECRET=your_production_client_secret
STRAVA_REDIRECT_URI=https://yourdomain.com/auth/strava/callback

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://...

# Redis (Railway provides this automatically)
REDIS_URL=redis://...

# Security keys — GENERATE NEW ONES FOR PRODUCTION!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_key_here
SESSION_SECRET=your_64_character_hex_key_here

# App
API_PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
